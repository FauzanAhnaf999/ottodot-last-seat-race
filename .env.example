# Supabase (optional — app works without it using in-memory store with same invariants)
# If set, the app can be wired to real Postgres. Current demo defaults to in-memory for zero-setup.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For race test via HTTP
BASE_URL=http://localhost:3000
